---
import Layout from '../layouts/Layout.astro';
import CategoryList from '../components/CategoryList.astro';
import { categories } from '../data/categories';
import { contact } from '../data/site';
---

<Layout>
  <section class="intro">
    <h1 class="intro__title">Agarwood oil and chips from Southeast Asia</h1>

    <div class="intro__lead">
      <p>
        Agarwood is the resinous heartwood that forms in an <em>Aquilaria</em> tree after
        the tree is wounded. It is the base of the finest oud perfumes. We collect from
        remote forests across the region and supply the best of what comes out of them.
      </p>
      <p>
        We handle two forms: chips and flakes sold by weight, and oil distilled from the
        same wood. Every batch is labelled by species and region.
      </p>
    </div>

    <ul class="intro__points">
      <li class="intro__points__item">
        <h2 class="intro__points__item__title">Multiple species</h2>
        <p>
          <em>Aquilaria malaccensis</em> and <em>Aquilaria filaria</em> at present, with
          more as supply allows.
        </p>
      </li>
      <li class="intro__points__item">
        <h2 class="intro__points__item__title">Origins</h2>
        <p>
          Sumatra, Kalimantan, Papua, Thailand and Laos, and elsewhere across the region. Both wild and planted.
        </p>
      </li>
      <li class="intro__points__item">
        <h2 class="intro__points__item__title">Multiple forms</h2>
        <p>Chips, flakes and distilled oil, in the quantity you need.</p>
      </li>
    </ul>

    <p class="intro__note">
      Every shipment goes out with CITES documentation, a certificate of origin and the
      batch papers for the lot.
    </p>
  </section>

  <section class="catalogue-section">
    <h2 class="section-title">What we offer</h2>
    <p class="section-intro">
      Price follows grade and weight. <a href="/contact/" class="link">Ask us</a>, or
      write to <a href={`mailto:${contact.email}`} class="link">{contact.email}</a>.
    </p>
    <CategoryList categories={categories} eager={true} />
  </section>
</Layout>
