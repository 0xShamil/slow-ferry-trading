---
/*
 * The ferry mark. The paths use `currentColor`, therefore the mark takes the
 * colour of the text around it.
 */
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor">
    <path d="M20 7.6h2.4v3.6H20z"></path>
    <path d="M11.2 11.2h8v5.2h-8z"></path>
    <path d="M4.8 16.4h22.4l-3.9 6H8.7l-3.9-6Z"></path>
  </g>
  <path
    d="M4.4 26.2q2.3-1.8 4.6 0t4.6 0 4.6 0 4.6 0"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"></path>
</svg>
