---
import Mark from './Mark.astro';
import { site, nav } from '../data/site';

const path = Astro.url.pathname;

/** True when `href` is the page that shows now. */
function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__link" aria-label={`${site.name}, home`}>
      <Mark />
      <span class="header__wordmark">
        <span class="header__wordmark__strong">Slow Ferry</span> Trading
      </span>
    </a>

    <nav class="header__nav" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="header__nav__link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
